<?xml version="1.0"?>
<sdf version="1.10">

  <world name="warehouse_world">

    <!-- ======================= -->
    <!-- GAZEBO SYSTEM PLUGINS   -->
    <!-- ======================= -->

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ======================= -->
    <!-- LIGHTING                -->
    <!-- ======================= -->

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 -0.5 -1</direction>
    </light>

    <!-- ======================= -->
    <!-- FLOOR                   -->
    <!-- ======================= -->

    <model name="warehouse_floor">
      <static>true</static>
      <pose>0 0 -0.1 0 0 0</pose>

      <link name="floor_link">

        <collision name="collision">
          <geometry>
            <box>
              <size>18 16 0.2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>18 16 0.2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ======================= -->
    <!-- WAREHOUSE WALLS         -->
    <!-- ======================= -->

    <model name="warehouse_walls">
      <static>true</static>

      <link name="walls_link">

        <!-- NORTH -->
        <collision name="north_collision">
          <pose>0 8 1 0 0 0</pose>
          <geometry>
            <box><size>18 0.2 2</size></box>
          </geometry>
        </collision>

        <visual name="north_visual">
          <pose>0 8 1 0 0 0</pose>
          <geometry>
            <box><size>18 0.2 2</size></box>
          </geometry>
        </visual>

        <!-- SOUTH -->
        <collision name="south_collision">
          <pose>0 -8 1 0 0 0</pose>
          <geometry>
            <box><size>18 0.2 2</size></box>
          </geometry>
        </collision>

        <visual name="south_visual">
          <pose>0 -8 1 0 0 0</pose>
          <geometry>
            <box><size>18 0.2 2</size></box>
          </geometry>
        </visual>

        <!-- WEST -->
        <collision name="west_collision">
          <pose>-9 0 1 0 0 0</pose>
          <geometry>
            <box><size>0.2 16 2</size></box>
          </geometry>
        </collision>

        <visual name="west_visual">
          <pose>-9 0 1 0 0 0</pose>
          <geometry>
            <box><size>0.2 16 2</size></box>
          </geometry>
        </visual>

        <!-- EAST -->
        <collision name="east_collision">
          <pose>9 0 1 0 0 0</pose>
          <geometry>
            <box><size>0.2 16 2</size></box>
          </geometry>
        </collision>

        <visual name="east_visual">
          <pose>9 0 1 0 0 0</pose>
          <geometry>
            <box><size>0.2 16 2</size></box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- ======================= -->
    <!-- STORAGE ROW A           -->
    <!-- ======================= -->

    <model name="shelf_A">
      <static>true</static>
      <pose>-6 0 0.75 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1 3 1.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>1 3 1.5</size></box>
          </geometry>

          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.35 0.38 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ROW A PICKUP -->
    <model name="A1_blue">
      <static>true</static>
      <pose>-6 3 0.6 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.6 1.2</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>0.8 0.6 1.2</size></box>
          </geometry>

          <material>
            <ambient>0.05 0.25 1 1</ambient>
            <diffuse>0.05 0.25 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ROW A DELIVERY -->
    <model name="A2_orange">
      <static>true</static>
      <pose>-6 -3 0.6 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.6 1.2</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>0.8 0.6 1.2</size></box>
          </geometry>

          <material>
            <ambient>1 0.35 0.02 1</ambient>
            <diffuse>1 0.35 0.02 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ======================= -->
    <!-- STORAGE ROW B           -->
    <!-- ======================= -->

    <model name="shelf_B">
      <static>true</static>
      <pose>-2 0 0.75 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1 3 1.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>1 3 1.5</size></box>
          </geometry>

          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.35 0.38 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="B1_blue">
      <static>true</static>
      <pose>-2 3 0.6 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.6 1.2</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>0.8 0.6 1.2</size></box>
          </geometry>

          <material>
            <ambient>0.05 0.25 1 1</ambient>
            <diffuse>0.05 0.25 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="B2_orange">
      <static>true</static>
      <pose>-2 -3 0.6 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.6 1.2</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>0.8 0.6 1.2</size></box>
          </geometry>

          <material>
            <ambient>1 0.35 0.02 1</ambient>
            <diffuse>1 0.35 0.02 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ======================= -->
    <!-- STORAGE ROW C           -->
    <!-- ======================= -->

    <model name="shelf_C">
      <static>true</static>
      <pose>2 0 0.75 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1 3 1.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>1 3 1.5</size></box>
          </geometry>

          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.35 0.38 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="C1_blue">
      <static>true</static>
      <pose>2 3 0.6 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.6 1.2</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>0.8 0.6 1.2</size></box>
          </geometry>

          <material>
            <ambient>0.05 0.25 1 1</ambient>
            <diffuse>0.05 0.25 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="C2_orange">
      <static>true</static>
      <pose>2 -3 0.6 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.6 1.2</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>0.8 0.6 1.2</size></box>
          </geometry>

          <material>
            <ambient>1 0.35 0.02 1</ambient>
            <diffuse>1 0.35 0.02 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ======================= -->
    <!-- STORAGE ROW D           -->
    <!-- ======================= -->

    <model name="shelf_D">
      <static>true</static>
      <pose>6 0 0.75 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1 3 1.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>1 3 1.5</size></box>
          </geometry>

          <material>
            <ambient>0.35 0.38 0.42 1</ambient>
            <diffuse>0.35 0.38 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="D1_blue">
      <static>true</static>
      <pose>6 3 0.6 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.6 1.2</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>0.8 0.6 1.2</size></box>
          </geometry>

          <material>
            <ambient>0.05 0.25 1 1</ambient>
            <diffuse>0.05 0.25 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="D2_orange">
      <static>true</static>
      <pose>6 -3 0.6 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.6 1.2</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>0.8 0.6 1.2</size></box>
          </geometry>

          <material>
            <ambient>1 0.35 0.02 1</ambient>
            <diffuse>1 0.35 0.02 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ======================= -->
    <!-- HOME DOCK               -->
    <!-- ======================= -->

    <model name="HOME_DOCK">
      <static>true</static>
      <pose>0 -6.2 0.005 0 0 0</pose>

      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>1.8 1.2 0.01</size></box>
          </geometry>

          <material>
            <ambient>0.05 0.85 0.25 1</ambient>
            <diffuse>0.05 0.85 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ======================= -->
    <!-- MOBILE ROBOT            -->
    <!-- ======================= -->

    <include>
      <uri>model://mobile_robot</uri>
      <name>mobile_robot</name>
      <pose>0 -6.2 0 0 0 1.5708</pose>
    </include>

  </world>

</sdf>